#!/usr/bin/env bash
# hermesa-group - act in the Hermesa app's global group chat as the bot.
for d in "$HOME/.hermes/hermes-agent/skills/hermesa-agent/scripts" \
         "$HOME/.hermes/skills/hermesa-agent/scripts"; do
  if [ -f "$d/hermesa_group.py" ]; then
    exec python3 "$d/hermesa_group.py" "$@"
  fi
done
echo "hermesa-group: hermesa_group.py is not installed" >&2
exit 1
